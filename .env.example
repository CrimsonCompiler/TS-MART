# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- MongoDB -----------------------------------------------------------
# Local dev defaults are fine if you have Mongo running locally.
# In production, use MongoDB Atlas and copy the SRV connection string, e.g.
#   mongodb+srv://USER:PASS@cluster0.abcd.mongodb.net/ts-mart?retryWrites=true&w=majority
# Whitelist your PaaS outbound IPs (or 0.0.0.0/0 for demo) in the Atlas
# "Network Access" tab.
MONGODB_URI=mongodb://localhost:27017/ts-mart

# --- Session store -----------------------------------------------------
# Optional: point the session store at a different DB/cluster than the app.
# Defaults to MONGODB_URI if not set.
# MONGO_SESSION_URI=mongodb://localhost:27017/ts-mart

# --- Session secret ----------------------------------------------------
# REQUIRED. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start if this is missing or too short.
SESSION_SECRET=replace-me-with-a-random-32-plus-character-string

# --- Server ------------------------------------------------------------
# Optional; defaults to 3000.
PORT=3000

# --- Trust proxy -------------------------------------------------------
# Set to the number of reverse proxies in front of the app (1 for Render /
# Railway / single Nginx). Defaults to 1 automatically when NODE_ENV=production.
# TRUST_PROXY=1

# --- Optional: order-tracking stage intervals --------------------------
# Seconds between order-tracking stages. The full lifecycle is roughly
# STAGES.length * this value (5 stages * 30s = 2.5 min for the demo).
STATUS_INTERVALS_SECONDS=30
