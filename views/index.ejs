<%- include('partials/header', { title: 'GlamBD — Considered Makeup, Bangladesh' }) %>

<!-- ============== HERO ============== -->
<section style="border-bottom: 1px solid var(--line);">
  <div class="container-page py-12 sm:py-16 grid md:grid-cols-12 gap-10 items-end">
    <div class="md:col-span-7">
      <p class="label-eyebrow"><span class="dot"></span> New edit · September</p>
      <h1 class="mt-5 brand-font text-4xl sm:text-6xl leading-[1.05]">
        Considered<br />
        makeup,<br />
        <em class="serif-quote" style="color: var(--ink-soft);">delivered softly.</em>
      </h1>
    </div>
    <div class="md:col-span-5">
      <p class="serif-quote text-xl leading-snug" style="color: var(--ink-soft);">
        Real brands, honest prices, and cash on delivery anywhere in Bangladesh — from Sylhet to Cox's Bazar.
      </p>
      <hr class="rule mt-6" />
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#shop" class="btn btn-primary">
          Browse the shop
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </a>
        <a href="/track" class="btn btn-ghost">Track an order</a>
      </div>
    </div>
  </div>

</section>

<!-- ============== SHOP GRID ============== -->
<section id="shop" class="container-page py-12">
  <div class="flex items-end justify-between gap-6 pb-6 border-b" style="border-color: var(--line);">
    <div>
      <p class="label-eyebrow mb-2"><span class="dot"></span> The Shop</p>
      <h2 class="brand-font text-3xl sm:text-4xl">Find your next favourite.</h2>
    </div>
    <p class="mono text-[11px] tracking-[0.2em] uppercase" style="color: var(--ink-muted);">
      <%= products.length %> pieces · ready to ship
    </p>
  </div>

  <% if (products.length === 0) { %>
    <div class="card mt-10 p-12 text-center">
      <p class="label-eyebrow mb-3"><span class="dot"></span> The shelves are bare</p>
      <p class="brand-font text-2xl">Nothing in stock yet.</p>
      <p class="text-sm mt-3" style="color: var(--ink-muted);">Run <code class="mono px-2 py-0.5" style="background: var(--bg-alt);">npm run seed</code> from the project root to populate the shop.</p>
    </div>
  <% } else { %>
    <div class="mt-8 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <% products.forEach(function(p) { %>
        <article class="group card overflow-hidden flex flex-col">
          <a href="/product/<%= p._id %>" class="block aspect-product overflow-hidden" style="background: var(--bg-alt);">
            <img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover hover-lift" loading="lazy" />
            <% if (p.stock <= 5) { %>
              <span class="floating-chip" style="top: .6rem; left: .6rem;">Only <%= p.stock %> left</span>
            <% } %>
          </a>
          <div class="p-4 flex-1 flex flex-col">
            <p class="mono text-[10px] tracking-[0.2em] uppercase mb-1.5" style="color: var(--ink-muted);"><%= p.category %></p>
            <a href="/product/<%= p._id %>" class="brand-font text-base leading-snug line-clamp-2 hover:text-[var(--ink-soft)]"><%= p.name %></a>
            <div class="mt-auto pt-3 flex items-baseline justify-between">
              <span class="brand-font text-base"><%= formatBDT(p.price) %></span>
              <span class="mono text-[10px] tracking-wider uppercase" style="color: var(--ink-muted);"><%= p.stock %> left</span>
            </div>
            <form action="/cart/add" method="post" class="mt-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="productId" value="<%= p._id %>" />
              <input type="hidden" name="qty" value="1" />
              <button type="submit" class="btn btn-primary btn-block btn-sm">Add to cart</button>
            </form>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<!-- Editorial selling line -->
<section class="border-y" style="border-color: var(--line); background: var(--bg-alt);">
  <div class="container-page py-12 grid sm:grid-cols-3 gap-10 text-center">
    <div>
      <p class="mono text-[10px] tracking-[0.25em] uppercase" style="color: var(--ink-muted);">01</p>
      <p class="brand-font text-lg mt-2">Cash on delivery</p>
      <p class="text-sm mt-2" style="color: var(--ink-soft);">Pay when your order arrives. No cards, no apps.</p>
    </div>
    <div>
      <p class="mono text-[10px] tracking-[0.25em] uppercase" style="color: var(--ink-muted);">02</p>
      <p class="brand-font text-lg mt-2">All 64 districts</p>
      <p class="text-sm mt-2" style="color: var(--ink-soft);">From Dhaka hills to coastal Chattogram.</p>
    </div>
    <div>
      <p class="mono text-[10px] tracking-[0.25em] uppercase" style="color: var(--ink-muted);">03</p>
      <p class="brand-font text-lg mt-2">Considered curation</p>
      <p class="text-sm mt-2" style="color: var(--ink-soft);">Every piece in stock. Every product tagged.</p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
