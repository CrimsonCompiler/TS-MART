<%- include('partials/header', { title: product.name + ' — GlamBD' }) %>

<section class="container-page py-10">
  <!-- Breadcrumb -->
  <nav class="mono text-[11px] tracking-[0.2em] uppercase flex items-center gap-2" style="color: var(--ink-muted);">
    <a href="/" class="hover:text-[var(--ink)]">Shop</a>
    <span>/</span>
    <span style="color: var(--ink);"><%= product.category %></span>
  </nav>
  <hr class="rule mt-3" />

  <div class="mt-8 grid md:grid-cols-12 gap-10 items-start">
    <!-- Image column -->
    <div class="md:col-span-7">
      <div class="aspect-square card overflow-hidden" style="background: var(--bg-alt);">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover" />
      </div>
      <div class="mt-3 flex justify-between mono text-[10px] tracking-[0.2em] uppercase" style="color: var(--ink-muted);">
        <span>Fig. <%= String(product._id).slice(-4).toUpperCase() %></span>
        <span><%= product.category %></span>
      </div>
    </div>

    <!-- Details column -->
    <div class="md:col-span-5 md:sticky md:top-28">
      <p class="label-eyebrow"><span class="dot"></span> <%= product.category %></p>
      <h1 class="mt-3 brand-font text-3xl sm:text-4xl leading-tight"><%= product.name %></h1>

      <hr class="rule my-6" />

      <p class="serif-quote text-lg leading-snug" style="color: var(--ink-soft);"><%= product.description %></p>

      <div class="mt-7 flex items-baseline gap-4">
        <span class="brand-font text-4xl"><%= formatBDT(product.price) %></span>
        <span class="mono text-[11px] tracking-[0.2em] uppercase" style="color: var(--ink-muted);"><%= product.stock %> in stock</span>
      </div>

      <hr class="rule my-6" />

      <form action="/cart/add" method="post" class="flex flex-wrap items-end gap-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="productId" value="<%= product._id %>" />
        <div>
          <label class="label-eyebrow block mb-2">Quantity</label>
          <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>"
                 class="field w-24 text-center mono" style="padding: .5rem 0;" />
        </div>
        <button type="submit" class="btn btn-primary">
          Add to cart
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
        </button>
      </form>

      <!-- Editorial specs -->
      <div class="mt-10 grid grid-cols-3" style="border-top: 1px solid var(--line);">
        <div class="py-5 pr-4 border-r" style="border-color: var(--line);">
          <p class="mono text-[10px] tracking-[0.25em] uppercase">Delivery</p>
          <p class="text-sm mt-2 leading-snug">Across all 64 districts of Bangladesh.</p>
        </div>
        <div class="py-5 px-4 border-r" style="border-color: var(--line);">
          <p class="mono text-[10px] tracking-[0.25em] uppercase">Payment</p>
          <p class="text-sm mt-2 leading-snug">Cash on delivery — no advance.</p>
        </div>
        <div class="py-5 pl-4">
          <p class="mono text-[10px] tracking-[0.25em] uppercase">Source</p>
          <p class="text-sm mt-2 leading-snug">Authorised retailers, authentic stock.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
